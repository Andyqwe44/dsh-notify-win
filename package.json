{
  "name": "dsh-notify-win",
  "version": "0.5.0",
  "description": "Native Windows toast + taskbar flash for DeepSeek Harness when a task finishes or your input is needed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-helper.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check scripts/build-helper.mjs",
    "test": "node test/flash-policy.mjs && node test/smoke.mjs && node test/proof.mjs && node test/helper-protocol.mjs",
    "prepublishOnly": "npm run build && npm run check && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "notification",
    "toast",
    "windows",
    "taskbar"
  ],
  "author": "Andyq",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andyqwe44/dsh-notify-win.git"
  },
  "bugs": {
    "url": "https://github.com/Andyqwe44/dsh-notify-win/issues"
  },
  "homepage": "https://github.com/Andyqwe44/dsh-notify-win#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "sessions",
        "remote"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
